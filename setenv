if [ -z $SETENV_LOADED ]; then
	export QT_QPA_PLATFORMTHEME="qt5ct"

	export MYSQL_PS1="\u@\h [\d]> "

	export GPGKEY=8F3CD8EE
	export EDITOR=/usr/bin/vim
	# Use bat as pager if available, fallback to most, then less
	if command -v bat &>/dev/null; then
		export PAGER="bat --style=plain --paging=always"
		export BAT_PAGER="less -R"
	elif command -v most &>/dev/null; then
		export PAGER=most
	else
		export PAGER=less
	fi
	export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

	export GIT_PS1_SHOWDIRTYSTATE=1
	export GIT_PS1_SHOWUNTRACKEDFILES=1
	export GIT_PS1_SHOWUPSTREAM="verbose"

	export PATH="$PATH:$HOME/bin"
	export PATH="$PATH:$HOME/.local/bin"
	export PATH="$PATH:$HOME/.cargo/bin"
	export PATH="$PATH:$HOME/.ghcup/bin"
	export PATH="$HOME/.rvm/bin:$PATH"
	export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

	export SETENV_LOADED=1
fi

# Load keychain only in interactive shells. Kept OUT of the SETENV_LOADED
# block on purpose: keychain 3.x multi-terminal coordination prints
# "Press Enter to initialize keys" and blocks on stdin. During ly's
# non-interactive X-session sourcing that prompt is invisible and hangs
# WM startup (black screen). The [[ $- == *i* ]] guard skips it there;
# --immediate elects one terminal to run ssh-add and drops the Enter gate.
if [[ $- == *i* ]] && command -v keychain &>/dev/null; then
	eval $(keychain --eval --ignore-missing --quiet --immediate id_ed25519 id_ed25519_ynd)
fi

# Must run per-shell, not once per env: tmux panes get their own pty and
# gpg-agent/pinentry-curses need to know the current tty to draw on.
GPG_TTY=$(tty)
export GPG_TTY
if [ -n "$GPG_TTY" ] && command -v gpg-connect-agent &>/dev/null; then
	gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
fi

